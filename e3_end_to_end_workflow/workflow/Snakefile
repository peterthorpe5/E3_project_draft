    rule aggregate_structural_alignment_shards:
        input:
            stage09=str(RUN_ROOT / "09_ligandability" / "stage_manifest.json"),
            token=str(stage_token_path(E3_CONFIG, "09b_structural_alignment")),
            markers=expand(
                str(
                    RUN_ROOT
                    / ".work_cache"
                    / "09b_structural_alignment"
                    / "task_{task}"
                    / "task_complete.tsv"
                ),
                task=STRUCTURAL_ALIGNMENT_TASKS,
            )
        output:
            manifest=str(
                RUN_ROOT / "09b_structural_alignment" / "stage_manifest.json"
            ),
